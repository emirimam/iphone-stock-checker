{
  "functions": {
    "api/check.js": {
      "maxDuration": 60
    },
    "api/settings.js": {
      "maxDuration": 30
    },
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "cleanUrls": true
}